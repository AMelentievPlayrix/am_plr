{
  "env": {
    "ANTHROPIC_BASE_URL": "https://litellm.playrix.com",
    "ANTHROPIC_AUTH_TOKEN": "<YOUR_ANTHROPIC_AUTH_TOKEN>",
    "CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY": "1",
    "API_FORCE_IDLE_TIMEOUT": "0"
  },
  "model": "opus[1m]",
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "permissions": {
    "allow": [
      "Bash(python3 -c ' *)",
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)",
      "mcp__qase__get_test_case_data",
      "mcp__asana__asana_create_task",
      "mcp__asana__asana_create_task_story"
    ]
  },
  "extraKnownMarketplaces": {
    "am-plr": {
      "source": {
        "source": "directory",
        "path": "${AM_PLR}"
      }
    }
  },
  "enabledPlugins": {
    "am-plr@am-plr": true
  }
}
